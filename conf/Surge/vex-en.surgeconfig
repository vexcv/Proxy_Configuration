# > Regional Groups
🇭🇰 香港节点 = url-test, update-interval=0, tolerance=20, include-other-group=♥️ 网速超快, evaluate-before-use=true, policy-regex-filter=(🇭🇰|港|澳门|🇲🇴|HK|Hong), hidden=1, icon-url=https://raw.githubusercontent.com/Semporia/Hand-Painted-icon/master/Rounded_Rectangle/Hong_Kong.png

🇨🇳 台湾节点 = url-test, update-interval=0, tolerance=20, include-other-group=♥️ 网速超快, evaluate-before-use=true, policy-regex-filter=(🇨🇳|🇹🇼|台|湾|TW|Taiwan), hidden=1, icon-url=https://raw.githubusercontent.com/Semporia/Hand-Painted-icon/master/Rounded_Rectangle/China.png

🇯🇵 日本节点 = url-test, update-interval=0, tolerance=20, include-other-group=♥️ 网速超快, evaluate-before-use=true, policy-regex-filter=(🇯🇵|日|东京|大阪|JP|Japan), hidden=1, icon-url=https://raw.githubusercontent.com/Semporia/Hand-Painted-icon/master/Rounded_Rectangle/Japan.png

🇰🇷 韩国节点 = url-test, update-interval=0, tolerance=20, include-other-group=♥️ 网速超快, evaluate-before-use=true, policy-regex-filter=(🇰🇷|韩|KR|Korea), hidden=1, icon-url=https://raw.githubusercontent.com/Semporia/Hand-Painted-icon/master/Rounded_Rectangle/South_Korea.png

🇸🇬 新加坡节点 = url-test, update-interval=0, tolerance=20, include-other-group=♥️ 网速超快, evaluate-before-use=true, policy-regex-filter=(🇸🇬|新加坡|坡|狮城|SG|Singapore), hidden=1, icon-url=https://raw.githubusercontent.com/Semporia/Hand-Painted-icon/master/Rounded_Rectangle/Singapore.png

🇺🇸 美国节点 = url-test, update-interval=0, tolerance=20, include-other-group=♥️ 网速超快, evaluate-before-use=true, policy-regex-filter=(🇺🇸|美|US|States|America), hidden=1, icon-url=https://raw.githubusercontent.com/Semporia/Hand-Painted-icon/master/Rounded_Rectangle/United_States.png

[Rule]
# > Block UDP 443
AND,((PROTOCOL,UDP), (DEST-PORT,443)),REJECT-NO-DROP

# > Prevent App Loop Requests
IP-CIDR,0.0.0.0/32,REJECT,no-resolve

# > Rule Correction
RULE-SET,https://raw.githubusercontent.com/Centralmatrix3/Matrix-io/master/Surge/Ruleset/Unbreak.list,DIRECT

# > WeChat Rules
